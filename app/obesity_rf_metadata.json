{
  "model": "RandomForestClassifier",
  "params": {
    "n_estimators": 400,
    "min_samples_leaf": 1,
    "max_features": "sqrt",
    "max_depth": 20,
    "class_weight": "balanced",
    "random_state": 42,
    "n_jobs": -1
  },
  "features": [
    "Gender",
    "Age",
    "family_history_with_overweight",
    "FCVC",
    "NCP",
    "CAEC",
    "CH2O",
    "FAF",
    "TUE",
    "CALC",
    "BMI_bucket",
    "Age_x_FCVC"
  ],
  "n_features": 12,
  "target_classes": [
    "Insufficient_Weight",
    "Normal_Weight",
    "Overweight_Level_I",
    "Overweight_Level_II",
    "Obesity_Type_I",
    "Obesity_Type_II",
    "Obesity_Type_III"
  ],
  "label_mapping": {
    "Insufficient_Weight": 0,
    "Normal_Weight": 1,
    "Overweight_Level_I": 2,
    "Overweight_Level_II": 3,
    "Obesity_Type_I": 4,
    "Obesity_Type_II": 5,
    "Obesity_Type_III": 6
  },
  "cv_f1_macro": 0.9471,
  "confidence_weights": {
    "a_cosine_sim": 0.0659,
    "b_model_proba": 0.99,
    "c_confusion_risk": 0.99,
    "d_demographic": 0.0603,
    "formula": "score = a*x + b*y - c*z + d*m"
  },
  "notes": [
    "BMI_bucket: 0=underweight(<18.5) 1=normal(18.5-25) 2=overweight(25-30) 3=obese(>30)",
    "Age_x_FCVC interaction feature included",
    "MTRANS, FAVC, SMOKE, SCC, Height, Weight, BMI dropped"
  ]
}