# Copy to .env (or export in your shell). Never commit real values.

# Streamlit -> FastAPI
OBESITY_API_URL=http://localhost:8001

# Model 2 bundle folder (relative to app/)
MODEL2_BUNDLE_DIR=model2_bundles

# RAG: Gemini (generation + optional embeddings)
GEMINI_API_KEY=
# GOOGLE_API_KEY is mirrored from GEMINI_API_KEY at runtime if unset

# RAG: optional OpenAI/Anthropic-compatible gateway (e.g. CMU AI Gateway)
GATEWAY_URL=
GATEWAY_API_KEY=

# RAG: optional direct Anthropic calls in indexer.py
ANTHROPIC_API_KEY=

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=papers_rag

# Optional external translator service (falls back to Gemini translation)
TRANSLATOR_URL=http://127.0.0.1:8080
